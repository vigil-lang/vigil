# Classifies TCP flows with a small quantized MLP and drops suspicious ones.
# The weights live in a map, so userspace can replace the model at run time.
from std.net import XdpContext, XdpAction, EthHdr, Ipv4Hdr, TcpHdr, ETH_HLEN, ETH_P_IP, IPPROTO_TCP
from std.ml import Mlp
from std.ml.tensor import Vector
from std.fixed import q8_8
from std.bpf import ktime_ns

const FEATURES: usize = 4
const HIDDEN: usize = 8
const CLASSES: usize = 2

struct FlowKey:
    saddr: u32
    daddr: u32
    sport: u16
    dport: u16

struct FlowStats:
    pkts: u64
    bytes: u64
    last_seen: u64
    iat_ewma: q8_8      # mean inter-arrival time, in microseconds

map flows: LruHash[FlowKey, FlowStats](max_entries=65536)
map model: Array[Mlp[q8_8, FEATURES, HIDDEN, CLASSES], 1]
event alerts: RingBuf[FlowKey](size=256 * 1024)

# Features in ranges that fit q8_8 (at most 128): packets, kilobytes, mean
# inter-arrival time in microseconds, mean packet size in units of 64 bytes.
def features(st: FlowStats) -> Vector[q8_8, FEATURES]:
    return Vector[q8_8, FEATURES]([
        q8_8.saturate(st.pkts),
        q8_8.saturate(st.bytes // 1024),
        st.iat_ewma,
        q8_8.saturate(st.bytes // max(st.pkts, 1) // 64),
    ])

@xdp(iface="eth0")
def classify(ctx: XdpContext) -> XdpAction:
    eth = ctx.parse[EthHdr](0)?
    if eth.proto != ETH_P_IP:
        return XdpAction.PASS
    ip = ctx.parse[Ipv4Hdr](ETH_HLEN)?
    if ip.protocol != IPPROTO_TCP:
        return XdpAction.PASS
    tcp = ctx.parse[TcpHdr](ETH_HLEN + ip.header_len())?

    key = FlowKey(ip.saddr, ip.daddr, tcp.sport, tcp.dport)
    now = ktime_ns()
    st = flows.get_or_insert(key, FlowStats(0, 0, now, q8_8.zero()))
    if st.pkts > 0:
        iat = q8_8.saturate((now - st.last_seen) // 1000)
        st.iat_ewma = st.iat_ewma.ewma(iat, alpha=q8_8.from_ratio(1, 8))
    st.pkts += 1
    st.bytes += u64(ctx.len())
    st.last_seen = now

    m = model[0]?
    if m.classify(features(st)) == 1:
        alerts.emit(key)
        return XdpAction.DROP
    return XdpAction.PASS
