# Tests call functions, use maps and `?`, and may print.
map seen: Hash[u32, u64](max_entries=16)

def first(x: u32) -> Option[u32]:
    if x > 0:
        return Some(x)
    return None

@test
def doubles() -> bool:
    v = first(21)?
    print(f"v is {v}")
    seen.insert(v, 1)
    return v * 2 == 42 and seen.contains(21)
