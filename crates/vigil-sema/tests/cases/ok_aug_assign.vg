# augmented assignments with operands of the target's type, a shift by an
# integer of another type, and an inferred variable
def f(b: u64, n: u8) -> u32:
    a: u32 = 1
    a += 2
    a -= u32(b)
    a *= 3
    a //= 2
    a %= 7
    a &= 0xff
    a |= 1
    a ^= 2
    a <<= n
    a >>= b
    x = 5
    x += a
    return a + x
