def size[N: u32]() -> u32:
    return N

def by_zero() -> u32:
    return size[7 // 0]()

def overflow() -> u32:
    return size[170141183460469231731687303715884105727 + 1]()

def shift() -> u32:
    return size[1 << 200]()

def repeat() -> u32:
    a = [0] * (4 % 0)
    return 0

def fine() -> u32:
    return size[7 // 2]()
