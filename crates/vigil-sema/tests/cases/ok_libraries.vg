from std.bpf import KprobeContext, ktime_ns
from std.fixed import fixed, q8_8, q16_16, quantize
from std.ml import Mlp, Linear, Perceptron, Centroids, DecisionTree, Classifier
from std.ml.tensor import Vector, Matrix, argmax, relu
from std.sketch import CountMin, Bloom

comptime def logistic(x: f64) -> f64:
    return 1.0 / (1.0 + exp(-x))

comptime def sigmoid_table() -> i32[64]:
    table = [0] * 64
    for i in range(64):
        x = (f64(i) - 32.0) / 4.0
        table[i] = i32(quantize(logistic(x), 8))
    return table

comptime def fib(n: u32) -> u64:
    a: u64 = 0
    b: u64 = 1
    i: u32 = 0
    while i < n:
        t = a + b
        a = b
        b = t
        i += 1
    return a

const SIGMOID: i32[64] = sigmoid_table()
const FIB_50: u64 = fib(50)

map models: Array[Mlp[q8_8, 4, 8, 2], 1]
map sketches: PerCpuArray[CountMin[4, 2048], 1]

struct Counter:
    n: u64

    @mut
    def bump(self, by: u64):
        self.n += by

    def doubled(self) -> u64:
        return self.n * 2

def sigmoid(x: q8_8) -> q8_8:
    i = min(max(x.to_int() * 4 + 32, 0), 63)
    return q8_8(SIGMOID[i])

@kprobe("f")
def p(ctx: KprobeContext) -> i32:
    c = Counter(0)
    c.bump(3)
    print(f"{c.doubled()} {FIB_50} {SIGMOID[40]}")
    s = sketches[0]?
    s.add(1)
    m = models[0]?
    x = Vector[q8_8, 4].fill(q8_8.one())
    cls = m.classify(x)
    v: Vector[i32, 3] = relu[i32, 3](Vector[i32, 3]([1, -2, 3]))
    w: q16_16 = q16_16.from_ratio(1, 3)
    print(f"{cls} {argmax[i32, 3](v)} {sigmoid(q8_8.from_int(1)).to_raw()}")
    print(f"{w.to_raw()} {s.estimate(1)}")
    return 0
