# Contracts that are not well formed, or not pure.
from std.bpf import KprobeContext, pid_tgid

map counts: Hash[u32, u64](max_entries=16)

@requires(n)
def not_a_condition(n: u32) -> u32:
    return n

@ensures(result)
def no_result(n: u32):
    pass

@requires(n > 1, n < 4)
def two_conditions(n: u32) -> u32:
    return n

@ensures(result > 0)
def hides_result(result: u32) -> u32:
    return result

@requires(counts.contains(n))
def reads_a_map(n: u32) -> u32:
    return n

def helper_user() -> u64:
    return pid_tgid()

@ensures(result <= helper_user())
def through_a_call(n: u64) -> u64:
    return n

@requires(True)
@kprobe("do_sys_openat2")
def program_requires(ctx: KprobeContext) -> i32:
    return 0

@requires(True)
comptime def at_compile_time() -> u32:
    return 1

@invariant(True)
def misplaced() -> u32:
    return 0

def bad_invariant(n: u32) -> u32:
    t: u32 = 0
    @invariant(t)
    for i in range(n):
        t += 1
    return t

# `is_some`, `is_none` and `value` exist in contracts only.
def unwrap(o: u32?) -> u32:
    if is_some(o):
        return 1
    return 0

@ensures(value(n) > 0)
def not_an_option(n: u32) -> u32:
    return n
