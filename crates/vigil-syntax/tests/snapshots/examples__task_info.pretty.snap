source: crates/vigil-syntax/tests/examples.rs
expression: printed
---
from std.bpf import KprobeContext, current_task
from kernel import task_struct

@kprobe("do_sys_openat2")
def who(ctx: KprobeContext) -> i32:
    task = kptr[task_struct](current_task())
    parent = task.real_parent
    print(f"pid {task.tgid} parent {parent.tgid} uid {task.cred.uid.val}")
    return 0
